{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "six33",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public (non-secret) variables. There are no server-side secrets: the
  // booking form posts straight to HubSpot and the scheduler is a Calendly
  // embed. If that ever changes, add secrets in the Cloudflare dashboard or
  // with `npx wrangler secret put <NAME>` rather than listing them here.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.six33consulting.com",
    "NEXT_PUBLIC_BOOKING_URL": "https://calendly.com/six33consulting/30min"
  }
}
